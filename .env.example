# Copy to .env for local overrides. Nothing here is needed for `npm run dev`:
# locally the site uses the jomiez.db file, the uploads/ folder and prints
# emails to the console. See ADMIN.md for going live.

# Signs admin logins. Required in production: a long random string (openssl rand -hex 32).
PAYLOAD_SECRET=

# Database. Unset = the local file jomiez.db. Production: a Turso database.
DATABASE_URI=
DATABASE_AUTH_TOKEN=

# Images. Unset = the local uploads/ folder. Production: Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Email for the contact form (Resend). Unset = emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=hello@jomiez.com
EMAIL_FROM_NAME=Jomiez

# Optional: pin the admin to one address (e.g. https://jomiez.com).
NEXT_PUBLIC_SERVER_URL=
