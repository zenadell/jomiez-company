# Copy to .env for local overrides. Nothing here is needed for `npm run dev`:
# locally the site uses the jomiez.db file, the uploads/ folder and prints
# emails to the console. In production (Render) set these in the service's
# Environment tab; render.yaml lists them. See ADMIN.md → Going live.
# Never commit real values.

# Signs admin logins and encrypts saved API keys. Required in production:
# a long random string (openssl rand -hex 32). Never change it once live.
PAYLOAD_SECRET=

# Database. Unset: the local file jomiez.db.
# Supabase (Postgres): the connection string. Tables go in the schema jomiez_site.
SUPABASE_DATABASE_URL=
# Optional: Supabase's CA certificate (PEM) for full certificate checks.
DATABASE_CA_CERT=
# Or a Turso (libSQL) database instead of Postgres:
DATABASE_URI=
DATABASE_AUTH_TOKEN=

# Images. Unset: the local uploads/ folder. Cloudinary (folder jomiez-site):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or Vercel Blob, when hosting on Vercel:
BLOB_READ_WRITE_TOKEN=

# Email (Resend). Unset: emails are printed to the server log.
RESEND_API_KEY=
# The sender, on a domain verified in Resend: an address, or "Name <address>".
# The old portfolio's name works; EMAIL_FROM is the same thing and wins if both are set.
LEAD_FROM_EMAIL=
EMAIL_FROM=
EMAIL_FROM_NAME=Jomiez
# Optional: where visitors' replies to the automatic answer go (default: the team address).
LEAD_REPLY_TO=

# The agent. Keys can also be saved (encrypted) in Agent settings.
# GEMINI_API_KEY also powers live voice conversations (Gemini Live).
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The agent's sight. Screenshots use a browser: Chrome on a Mac, Chromium downloaded on first use on
# Linux servers with 1.5 GB or more, or a browser service (BROWSER_WS_ENDPOINT, e.g. wss://… from Browserless).
BROWSER_WS_ENDPOINT=
BROWSER_EXECUTABLE_PATH=
# Optional: where a Linux server fetches its Chromium the first time (default: the
# @sparticuz/chromium release matching the installed version).
CHROMIUM_PACK_URL=
# Optional: free photos from Pexels (otherwise public-domain images from Openverse).
PEXELS_API_KEY=
# Where the agent emails you after acting on its own (else Agent settings / Site settings).
ADMIN_NOTIFY_EMAIL=
# Lets an outside scheduler call /api/agent/tick (Authorization: Bearer <value>).
CRON_SECRET=
# Time zone for the agent's sense of "today" (default Africa/Lagos).
AGENT_TIMEZONE=

# Optional: pin the admin to one address (e.g. https://jomiez.com), once the domain works.
NEXT_PUBLIC_SERVER_URL=
